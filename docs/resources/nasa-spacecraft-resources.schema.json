{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NASA Spacecraft Mission Design Resource Catalog",
  "description": "An extraction catalog of the supplied research reference. Schema validation checks structure, not the truth or current availability of cited resources. Cross-record uniqueness, reference integrity and source coverage require separate checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "title",
    "status",
    "source_document",
    "extraction",
    "verification",
    "summary",
    "resources",
    "named_resources_without_direct_links",
    "external_references"
  ],
  "properties": {
    "$schema": {
      "const": "./nasa-spacecraft-resources.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "research_reference_only"
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "repository_path",
        "title",
        "last_reviewed_as_stated",
        "sha256",
        "line_count"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "repository_path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "last_reviewed_as_stated": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "scope",
        "deduplication",
        "editorial_metadata",
        "unlinked_mentions"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "deduplication": {
          "type": "string",
          "minLength": 1
        },
        "editorial_metadata": {
          "type": "string",
          "minLength": 1
        },
        "unlinked_mentions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "live_urls_checked",
        "scientific_claims_independently_verified",
        "usage_terms_checked",
        "source_register",
        "note"
      ],
      "properties": {
        "status": {
          "const": "extracted_from_supplied_markdown"
        },
        "live_urls_checked": {
          "const": false
        },
        "scientific_claims_independently_verified": {
          "const": false
        },
        "usage_terms_checked": {
          "const": false
        },
        "source_register": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linked_resources",
        "citation_occurrences",
        "distinct_cited_urls_including_fragments",
        "named_resources_without_direct_links",
        "external_references",
        "resources_by_category"
      ],
      "properties": {
        "linked_resources": {
          "type": "integer",
          "minimum": 0
        },
        "citation_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_cited_urls_including_fragments": {
          "type": "integer",
          "minimum": 0
        },
        "named_resources_without_direct_links": {
          "type": "integer",
          "minimum": 0
        },
        "external_references": {
          "type": "integer",
          "minimum": 0
        },
        "resources_by_category": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "hazards",
              "materials",
              "orbits",
              "propulsion",
              "reliability",
              "research_tools",
              "servicing",
              "small_bodies",
              "space_weather",
              "spacecraft_systems",
              "stations",
              "visual_assets"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_as_cited",
          "url",
          "host",
          "resource_type",
          "category",
          "description",
          "citation_labels",
          "caveats_from_reference",
          "source_occurrences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title_as_cited": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "host": {
            "type": "string",
            "pattern": "(^|\\.)nasa\\.gov$"
          },
          "resource_type": {
            "enum": [
              "api_documentation",
              "case_study",
              "catalog",
              "dataset_landing_page",
              "mission_reference",
              "portal",
              "program_overview",
              "report",
              "service_notice",
              "standard",
              "standards_index",
              "technical_reference",
              "usage_guidance",
              "visual_asset_catalog"
            ]
          },
          "category": {
            "enum": [
              "hazards",
              "materials",
              "orbits",
              "propulsion",
              "reliability",
              "research_tools",
              "servicing",
              "small_bodies",
              "space_weather",
              "spacecraft_systems",
              "stations",
              "visual_assets"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "citation_labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "caveats_from_reference": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "section_path",
                "citation_kind",
                "label",
                "cited_url"
              ],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "section_path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "citation_kind": {
                  "enum": [
                    "markdown_link",
                    "yaml_value"
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "cited_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          }
        }
      }
    },
    "named_resources_without_direct_links": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_lines",
          "related_resource_ids",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "related_resource_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "external_references": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "domain_as_cited",
          "source_lines",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domain_as_cited": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
